{
  "name": "paint-contractor",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri-cli.mjs dev",
    "dev:vite": "vite",
    "dev:test": "cross-env VITE_TAURI_MOCK=1 vite --strictPort --port 1421",
    "build": "tsc && vite build",
    "build:win": "node scripts/tauri-build.mjs",
    "build:win:signed": "node scripts/tauri-build.mjs --signed",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit src/**/*.test.{ts,tsx}",
    "test:integration": "vitest run tests/integration",
    "test:plugins": "vitest run tests/tauri-plugins",
    "test:contract": "vitest run tests/contract",
    "test:property": "vitest run tests/property",
    "test:snapshot": "vitest run tests/snapshot",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:confirm": "playwright test tests/e2e/confirm-delete.spec.ts",
    "test:smoke": "playwright test tests/smoke --reporter=list",
    "test:a11y": "vitest run tests/a11y",
    "test:webdriver": "cd webdriver/webdriverio && npm install && npm test",
    "test:webdriver:destructive": "cd webdriver/webdriverio && npm install && npm run test:destructive",
    "setup:msedgedriver": "powershell -ExecutionPolicy Bypass -File webdriver/scripts/setup-msedgedriver.ps1",
    "test:all": "npm run test && npm run test:rust && npm run test:e2e && npm run test:smoke",
    "test:full": "npm run test:all && npm run test:webdriver && npm run test:webdriver:destructive"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "bootstrap": "^5.3.3",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.7",
    "axe-core": "^4.11.4",
    "cross-env": "^10.1.0",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
